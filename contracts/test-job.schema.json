{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallel-ai-test-orchestrator.local/contracts/test-job.schema.json",
  "title": "AI test job status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "task_id",
    "repository",
    "branch",
    "base_sha",
    "status",
    "prepare_attempt",
    "verify_attempt",
    "version",
    "artifacts",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "job_id": { "$ref": "#/$defs/jobId" },
    "task_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "repository": { "type": "string", "minLength": 1, "maxLength": 300 },
    "branch": { "type": "string", "minLength": 1, "maxLength": 255 },
    "base_sha": { "$ref": "#/$defs/gitSha" },
    "code_sha": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
    "tested_sha": { "oneOf": [{ "$ref": "#/$defs/gitSha" }, { "type": "null" }] },
    "status": { "$ref": "#/$defs/status" },
    "prepare_attempt": { "type": "integer", "minimum": 0 },
    "verify_attempt": { "type": "integer", "minimum": 0 },
    "version": { "type": "integer", "minimum": 0 },
    "failure_class": {
      "type": ["string", "null"],
      "enum": [null, "TEST_FAILURE", "CONTRACT", "POLICY", "AGENT", "INFRASTRUCTURE", "TIMEOUT", "CANCELLED"]
    },
    "failure_message": { "type": ["string", "null"], "maxLength": 2000 },
    "artifacts": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "jobId": { "type": "string", "pattern": "^atj_[0-9a-f]{32}$" },
    "gitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "status": {
      "enum": [
        "PREPARE_QUEUED", "PREPARING", "WAITING_FOR_CODE", "VERIFY_QUEUED",
        "GENERATING_TESTS", "TEST_QUEUED", "TESTING", "PASSED", "FAILED",
        "BLOCKED", "ERROR", "TIMEOUT", "SUPERSEDED", "CANCELLED"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "object_key", "sha256", "size_bytes", "created_at", "url"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "enum": ["PLAN", "DRAFT", "PATCH", "CODEX_JSONL", "RAW_LOG", "JUNIT", "COVERAGE", "RESULT"] },
        "object_key": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": ["string", "null"], "maxLength": 200 },
        "created_at": { "type": "string", "format": "date-time" },
        "url": { "type": "string", "pattern": "^/api/v1/test-jobs/" }
      }
    }
  }
}
